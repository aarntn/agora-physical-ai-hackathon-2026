AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AI_API_KEY=
# LLM used by the Agora agent (OpenAI-compatible chat completions)
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# TTS: vendor + params JSON, e.g. {"key":"...","region":"southeastasia","voice_name":"ms-MY-YasminNeural"}
TTS_VENDOR=microsoft
TTS_PARAMS_JSON={}
ASR_LANG_EN=en-US
ASR_LANG_MS=ms-MY
# Public HTTPS URL of the backend (tunnel or host) that Agora calls for tools
PUBLIC_BASE_URL=
# Shared secrets: device -> backend, Agora tools -> backend (generate random values)
DEVICE_KEY=
TOOL_SECRET=
AGENT_RTC_UID=1001
NASOCHECK_LOG=data/events.jsonl
# Rejection thresholds (proposal §8 defaults); tune on the day, then freeze
NC_MIN_VOICED_FRAMES=15
NC_MIN_ACCEL_SNR_DB=6
NC_MAX_SPREAD_DB=4
NC_MIN_IMU_HZ=1000
